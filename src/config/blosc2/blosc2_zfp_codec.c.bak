/**
 * @file blosc2_zfp_codec.c
 * @brief Blosc2 User-Defined Codec Wrapper for ZFP
 * 
 * Allows the Blosc2 engine to use statically bundled ZFP as an internal 
 * compression backend (Codec ID 6).
 */

#include <blosc2.h>
#include <zfp.h>
#include <stdint.h>
#include <stdlib.h>

#define BLOSC_CODEC_ZFP 6

/* =========================================================================
 *  ZFP ENCODER FOR BLOSC2
 * ========================================================================= */
static int zfp_blosc2_encoder(const uint8_t *input, int32_t input_len, 
                              uint8_t *output, int32_t output_len, 
                              uint8_t meta, blosc2_cparams *cparams, 
                              const void* chunk) {
    
    /* Blosc2 provides the element size, but not the specific type (int vs float).
     * The standard Blosc2-ZFP convention assumes 4-byte = float, 8-byte = double.
     */
    zfp_type zt;
    if (cparams->typesize == 4) {
        zt = zfp_type_float;
    } else if (cparams->typesize == 8) {
        zt = zfp_type_double;
    } else {
        /* ZFP only supports 32/64-bit data. Return 0 to tell Blosc2 this chunk is incompressible. */
        return 0; 
    }

    size_t nitems = (size_t)input_len / cparams->typesize;
    
    /* 1. Setup the ZFP field */
    zfp_field *field = zfp_field_1d((void *)input, zt, nitems);
    if (!field) return 0;

    /* 2. Setup the ZFP stream */
    zfp_stream *zfp = zfp_stream_open(NULL);
    if (!zfp) {
        zfp_field_free(field);
        return 0;
    }

    /* 3. Map Blosc2's clevel (1-9) to ZFP's Precision Mode.
     *    Float precision maxes out around 32 bits, Double around 64 bits.
     */
    int precision;
    if (zt == zfp_type_float) {
        precision = cparams->clevel * 4;  /* clevel 9 -> ~36 bits */
    } else {
        precision = cparams->clevel * 7;  /* clevel 9 -> ~63 bits */
    }
    zfp_stream_set_precision(zfp, precision);

    /* 4. Setup the bitstream targeting the Blosc2 output buffer */
    bitstream *bstr = stream_open(output, (size_t)output_len);
    if (!bstr) {
        zfp_stream_close(zfp);
        zfp_field_free(field);
        return 0;
    }
    zfp_stream_set_bit_stream(zfp, bstr);

    /* 5. Write the self-describing header so the decoder doesn't need external hints */
    if (!zfp_write_header(zfp, field, ZFP_HEADER_FULL)) {
        stream_close(bstr);
        zfp_stream_close(zfp);
        zfp_field_free(field);
        return 0;
    }

    /* 6. Compress */
    size_t zfpsize = zfp_compress(zfp, field);
    zfp_stream_flush(zfp);

    /* Check if compression failed or expanded beyond the allocated Blosc2 block */
    if (zfpsize == 0 || zfpsize >= (size_t)output_len) {
        zfpsize = 0; 
    }

    /* 7. Cleanup */
    stream_close(bstr);
    zfp_stream_close(zfp);
    zfp_field_free(field);

    return (int)zfpsize;
}

/* =========================================================================
 *  ZFP DECODER FOR BLOSC2
 * ========================================================================= */
static int zfp_blosc2_decoder(const uint8_t *input, int32_t input_len, 
                              uint8_t *output, int32_t output_len, 
                              uint8_t meta, blosc2_dparams *dparams, 
                              const void* chunk) {
    
    /* 1. Setup the bitstream from the Blosc2 input buffer */
    bitstream *bstr = stream_open((void *)input, (size_t)input_len);
    if (!bstr) return 0;

    /* 2. Setup the ZFP stream */
    zfp_stream *zfp = zfp_stream_open(bstr);
    if (!zfp) {
        stream_close(bstr);
        return 0;
    }

    /* 3. Setup the ZFP field and read the header written by the encoder */
    zfp_field *field = zfp_field_alloc();
    if (!field) {
        zfp_stream_close(zfp);
        stream_close(bstr);
        return 0;
    }

    if (!zfp_read_header(zfp, field, ZFP_HEADER_FULL)) {
        zfp_field_free(field);
        zfp_stream_close(zfp);
        stream_close(bstr);
        return 0;
    }

    /* 4. Link the field to the Blosc2 output buffer */
    zfp_field_set_pointer(field, output);

    /* 5. Decompress */
    if (!zfp_decompress(zfp, field)) {
        zfp_field_free(field);
        zfp_stream_close(zfp);
        stream_close(bstr);
        return 0;
    }

    /* 6. Cleanup */
    zfp_field_free(field);
    zfp_stream_close(zfp);
    stream_close(bstr);

    /* Blosc2 expects the exact uncompressed bytes returned */
    return output_len; 
}

/* =========================================================================
 *  BLOSC2 CODEC REGISTRATION STRUCT
 * ========================================================================= */
blosc2_codec zfp_codec = {
    .compcode = BLOSC_CODEC_ZFP, 
    .compname = "zfp",
    .complib  = 1,
    .version  = 1,
    .encoder  = zfp_blosc2_encoder,
    .decoder  = zfp_blosc2_decoder
};
