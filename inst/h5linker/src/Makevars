# src/Makevars for h5linker package

R_HOME ?= $(shell R RHOME)

# Add --no-init-file and --no-environ
PKG_CPPFLAGS = $(shell $(R_HOME)/bin/Rscript --vanilla --no-init-file --no-environ -e "cat(hdf5lib::c_flags())")
PKG_LIBS = $(shell $(R_HOME)/bin/Rscript --vanilla --no-init-file --no-environ -e "cat(hdf5lib::ld_flags())")