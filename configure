#!/bin/sh
set -e

echo "--- [hdf5lib] Starting Windows/Unix configuration (STATIC) ---"

# Input directories
WD="$(pwd)"
ZLIB_SRC="$WD/src/zlib-1.3.1"
HDF5_SRC="$WD/src/hdf5-2.0.0"

# Find R
R_EXE="$R_HOME/bin$R_ARCH_BIN/R"
if ! test -f "$R_EXE"; then
  R_EXE="$R_HOME/bin/R"
  if ! test -f "$R_EXE"; then
    R_EXE=$(which R 2>/dev/null)
    if ! test -f "$R_EXE"; then
      echo "R was not found on the PATH. Please install R."
      exit 1
    fi
  fi
fi

# Get R's compiler/linker flags to ensure we respect the build environment
R_CC=$("$R_EXE" CMD config CC)
R_CFLAGS=$("$R_EXE" CMD config CFLAGS)
R_CPICFLAGS=$("$R_EXE" CMD config CPICFLAGS)
R_CPPFLAGS=$("$R_EXE" CMD config CPPFLAGS)
R_LDFLAGS=$("$R_EXE" CMD config LDFLAGS)

R_AR=$("$R_EXE" CMD config AR)
R_MAKE=$("$R_EXE" CMD config MAKE)
if [ -z "$R_AR" ];   then R_AR="ar";     fi
if [ -z "$R_MAKE" ]; then R_MAKE="make"; fi

# Determine parallelism
case " $MAKEFLAGS " in
  *\ -j*|*\ --jobs*) ;;
  *)                 R_MAKE="$R_MAKE -j4";;
esac

# Conditionally quote R_INCLUDE_DIR if it contains whitespace.
R_INCLUDE_DIR=$("$R_EXE" -s -e "cat(R.home('include'))")
case "$R_INCLUDE_DIR" in
  *\ *) R_INCLUDE_DIR="\"$R_INCLUDE_DIR\"" ;;
esac

# Combine flags
# Note: -w disables warnings which is cleaner for the console output
# 1. Added -DH5_BUILT_AS_STATIC_LIB to inform HDF5 internals we are static.
# 2. Explicitly defined -DH5_DLL="" and -DH5HL_DLL="" to empty. 
#    This fixes "unknown type name 'H5HL_DLL'" errors by ensuring the macro 
#    always exists and adds no attributes (correct for static libs).
# 3. Add -I includes for HDF5 internal headers and ZLIB
export CC="$R_CC"
export CFLAGS="$R_CFLAGS $R_CPICFLAGS -O2 -g0 -w"
export CPPFLAGS="-I. -Isrc -Ihl/src -I$ZLIB_SRC -I$R_INCLUDE_DIR $R_CPPFLAGS -DH5_BUILT_AS_STATIC_LIB -DH5_DLL= -DH5HL_DLL="

echo "          WD: $WD"
echo "      R_HOME: $R_HOME"
echo "       R_EXE: $R_EXE"
echo "          CC: $CC"
echo "      CFLAGS: $CFLAGS"
echo "    CPPFLAGS: $CPPFLAGS"


# Detect OS and set executable extension
case "$(uname -s)" in
  CYGWIN*|MINGW*|MSYS*) WIN=1; EXE=".exe";;
  *)                    WIN=0; EXE="";;
esac


# Extract hdf5 and zlib tarballs
echo "--- [hdf5lib] Decompressing HDF5 and zlib tarballs..."
cd "$WD/src"
$R_EXE -q -e "utils::untar('hdf5-2.0.0.tar.gz')"
$R_EXE -q -e "utils::untar('zlib-1.3.1.tar.gz')"


# --- 1. Build static zlib ---
echo "--- [hdf5lib] Configuring and compiling static zlib..."
cd "$ZLIB_SRC"
if [ "$WIN" -eq 1 ]; then
  echo "--- [hdf5lib] Using win32/Makefile.gcc for zlib (Windows)."
  make -f win32/Makefile.gcc libz.a
else
  echo "--- [hdf5lib] Using configure for zlib (Unix)."
  chmod +x ./configure
  ./configure --static
  make libz.a
fi


# --- 2. Build Static HDF5 2.0 (Manual Compilation) ---
echo "--- [hdf5lib] Configuring HDF5 2.0..."
cd "$HDF5_SRC"


# --- A. GENERATOR PHASE ---

# 1. Generate H5_sizeof.h (Type Sizes)
echo "--- [hdf5lib] Generating H5_sizeof.h..."
$CC $CPPFLAGS $CFLAGS -o gen_sizeof$EXE ../gen_sizeof.c
./gen_sizeof${EXE} > src/H5_sizeof.h


# --- B. COMPILATION PHASE ---
echo "--- [hdf5lib] Compiling HDF5 Sources (Parallel)..."

# Run Make using the pre-generated Makefile
# We inject the R-configured compiler flags here
echo "Running $R_MAKE ..."
$R_MAKE CC="$CC" CFLAGS="$CFLAGS" CPPFLAGS="$CPPFLAGS"


# --- 3. Combine, Link, and Archive ---
echo "--- [hdf5lib] Combining all object files into a single static library..."

$R_AR -x  "$ZLIB_SRC/libz.a"
$R_AR -crs libhdf5z.a *.o
if command -v strip >/dev/null 2>&1; then
    strip -S libhdf5z.a || true
fi

# --- 5. Install Libraries and Headers for R ---
echo "--- [hdf5lib] Installing to inst/..."
cd "$WD"
mkdir -p inst/lib
mkdir -p inst/include

# Copy headers
cp "$HDF5_SRC"/src/*.h    inst/include/
cp "$HDF5_SRC"/hl/src/*.h inst/include/

# Copy the static lib
cp "$HDF5_SRC"/libhdf5z.a inst/lib/

echo "--- [hdf5lib] Cleaning up build-time directories..."
rm -rf src

echo "--- [hdf5lib] Configuration complete. ---"
exit 0
