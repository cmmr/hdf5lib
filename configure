#!/bin/sh
set -e

echo "--- [hdf5lib] Starting Configuration (Static) ---"

# 1. Environment Setup ---------------------------------------------------------
WD="$(pwd)"
ZLIB_SRC="$WD/src/zlib-1.3.1"
HDF5_SRC="$WD/src/hdf5-2.0.0"

# Locate R and ensure it exists
R_EXE="${R_HOME}/bin${R_ARCH_BIN}/R"
if [ ! -f "$R_EXE" ]; then
  R_EXE="${R_HOME}/bin/R"
  if [ ! -f "$R_EXE" ]; then
    R_EXE=$(which R 2>/dev/null || true)
    if [ -z "$R_EXE" ]; then
      echo "Error: R not found. Please ensure R is installed and in your PATH."
      exit 1
    fi
  fi
fi


# Detect OS (Windows vs Unix) for logic branching
case "$(uname -s)" in
  CYGWIN*|MINGW*|MSYS*) WIN=1; EXE=".exe" ;;
  *)                    WIN=0; EXE=""     ;;
esac


# 2. R Configuration Inspection ------------------------------------------------
# Fetch compilation flags from R to ensure binary compatibility
R_CC=$("$R_EXE" CMD config CC)
R_CFLAGS=$("$R_EXE" CMD config CFLAGS)
R_CPICFLAGS=$("$R_EXE" CMD config CPICFLAGS)
R_CPPFLAGS=$("$R_EXE" CMD config CPPFLAGS)
R_LDFLAGS=$("$R_EXE" CMD config LDFLAGS)
R_AR=$("$R_EXE" CMD config AR)
R_MAKE=$("$R_EXE" CMD config MAKE)
R_LD=$("$R_EXE" CMD config LD)

# Set defaults if R config returns empty
: "${R_AR:=ar}"
: "${R_MAKE:=make}"
: "${R_LD:=ld}"

# Handle R_INCLUDE_DIR potentially containing spaces
R_INC=$("$R_EXE" -s -e "cat(R.home('include'))")
case "$R_INC" in
  *\ *) R_INC="\"$R_INC\"" ;;
esac

# Construct final flags
# -w: Disable warnings to keep build logs clean
# -DH5_BUILT_AS_STATIC_LIB: Inform HDF5 we are building statically
# -DH5_DLL="": Ensure export macros are empty
export CC="$R_CC"
export CFLAGS="$R_CFLAGS $R_CPICFLAGS -O2 -g0 -w"
export CPPFLAGS="-I. -Isrc -Ihl/src -I$ZLIB_SRC -I$R_INC $R_CPPFLAGS -DH5_BUILT_AS_STATIC_LIB -DH5_DLL= -DH5HL_DLL="

echo "  CC:       $CC"
echo "  CFLAGS:   $CFLAGS"
echo "  CPPFLAGS: $CPPFLAGS"


# 3. Build Dependencies --------------------------------------------------------
echo "--- [hdf5lib] Decompressing sources..."
cd "$WD/src"
"$R_EXE" -q -e "utils::untar('hdf5-2.0.0.tar.gz')"
"$R_EXE" -q -e "utils::untar('zlib-1.3.1.tar.gz')"

echo "--- [hdf5lib] Building ZLIB..."
cd "$ZLIB_SRC"
if [ "$WIN" -eq 1 ]; then
  "$R_MAKE" -f win32/Makefile.gcc libz.a >/dev/null
else
  chmod +x ./configure
  ./configure --static >/dev/null
  "$R_MAKE" libz.a >/dev/null
fi


# 4. Build HDF5 ----------------------------------------------------------------
echo "--- [hdf5lib] Building HDF5..."
cd "$HDF5_SRC"

# A. Generators
# Compile and run generator to detect system type sizes (creates src/H5_sizeof.h)
$CC $CPPFLAGS $CFLAGS -o gen_sizeof$EXE ../gen_sizeof.c
./gen_sizeof$EXE | tr -d '\r' > src/H5_sizeof.h

# B. Compilation
# Determine parallelism (default to -j4 if not specified by user)
case " $MAKEFLAGS " in
  *\ -j*|*\ --jobs*) N_JOBS="" ;;
  *)                 N_JOBS="-j4" ;;
esac

# Use the pre-generated Makefile (from prep_hdf5.r) to build all objects
"$R_MAKE" $N_JOBS CC="$CC" CFLAGS="$CFLAGS" CPPFLAGS="$CPPFLAGS" >/dev/null


# 5. Link and Archive ----------------------------------------------------------
echo "--- [hdf5lib] Linking static library..."

# Extract ZLIB objects to merge them into the final library
"$R_AR" -x "$ZLIB_SRC/libz.a"

# Logic: Use partial linking (ld -r) on non-Windows systems to reduce size.
# On Windows, or if 'ld' is missing, fallback to standard archiving.
if [ "$WIN" -eq 0 && command -v "$R_LD" >/dev/null 2>&1 ]; then
  # Merge all .o files into one big object (deduplicates symbols/sections)
  "$R_LD" -r -o libhdf5.obj *.o
  rm *.o
  mv libhdf5.obj libhdf5.o
fi

# Create the final static library
"$R_AR" -crs libhdf5z.a *.o

# Strip debug symbols to reduce installed package size
if command -v strip >/dev/null 2>&1; then
  strip -S libhdf5z.a || true
fi


# 6. Installation --------------------------------------------------------------
echo "--- [hdf5lib] Installing..."
cd "$WD"
mkdir -p inst/lib inst/include

# Install headers and library
cp "$HDF5_SRC"/src/*.h    inst/include/
cp "$HDF5_SRC"/hl/src/*.h inst/include/
cp "$HDF5_SRC"/libhdf5z.a inst/lib/

# Cleanup
rm -rf src

echo "--- [hdf5lib] Done. ---"
exit 0
