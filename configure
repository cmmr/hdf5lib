#!/bin/sh
set -e

HDF5_VER="2.0.0"
ZLIBNG_VER="2.3.3"
LIBAEC_VER="1.1.6"
LZ4_VER="1.10.0"
LZF_VER="3.6"
ZSTD_VER="1.5.7"
BLOSC_VER="1.21.6"
BZIP2_VER="1.0.8"


# 1. Prepare Build and Install Directories -------------------------------------
mkdir -p build
mkdir -p inst/lib
mkdir -p inst/include

cd build



echo "--- [hdf5lib] Starting Configuration (Static) ---"

# 2. Environment Setup ---------------------------------------------------------

# Locate R and ensure it exists
R_EXE="${R_HOME}/bin${R_ARCH_BIN}/R"
if [ ! -f "$R_EXE" ]; then
  R_EXE="${R_HOME}/bin/R"
  if [ ! -f "$R_EXE" ]; then
    R_EXE=$(which R 2>/dev/null || true)
    if [ -z "$R_EXE" ]; then
      echo "Error: R not found. Please ensure R is installed and in your PATH."
      exit 1
    fi
  fi
fi


# Detect OS (Windows vs Unix) for logic branching
case "$(uname -s)" in
  CYGWIN*|MINGW*|MSYS*) WIN=1; EXE=".exe" ;;
  *)                    WIN=0; EXE=""     ;;
esac



# 3. R Configuration Inspection ------------------------------------------------
# Fetch compilation flags from R to ensure binary compatibility
R_CC=$("$R_EXE" CMD config CC)
R_CFLAGS=$("$R_EXE" CMD config CFLAGS)
R_CPICFLAGS=$("$R_EXE" CMD config CPICFLAGS)
R_CPPFLAGS=$("$R_EXE" CMD config CPPFLAGS)
R_AR=$("$R_EXE" CMD config AR)
R_MAKE=$("$R_EXE" CMD config MAKE)

# Set defaults if R config returns empty
: "${R_AR:=ar}"
: "${R_MAKE:=make}"

# Add optimization flag if not already present
case " $R_CFLAGS " in
  *" -O"*) R_CFLAGS="$R_CFLAGS" ;;
  *)       R_CFLAGS="$R_CFLAGS -O2" ;;
esac


# Capture Runtime/Linker Flags (e.g. Sanitizers)
# We need to propagate flags like -fsanitize=address to consumer packages
# so they can successfully link against our static library.

for flag in $R_CFLAGS; do
  case "$flag" in
    -fsanitize=*) echo "$flag" >> inst/exported_flags.txt ;;
  esac
done


# 4. Set up build directory and vars -------------------------------------------
echo "--- [hdf5lib] Extracting source tarballs..."


tar -xf "../src/hdf5-$HDF5_VER.tar.gz"
tar -xf "../src/zlib-ng-$ZLIBNG_VER.tar.gz"
tar -xf "../src/libaec-$LIBAEC_VER.tar.gz"
tar -xf "../src/lz4-$LZ4_VER.tar.gz"
tar -xf "../src/liblzf-$LZF_VER.tar.gz"
tar -xf "../src/zstd-$ZSTD_VER.tar.gz"
tar -xf "../src/blosc-$BLOSC_VER.tar.gz"
tar -xf "../src/bzip2-$BZIP2_VER.tar.gz"

# Standardize directory names for the build loops
mv "hdf5-$HDF5_VER"         hdf5
mv "zlib-ng-$ZLIBNG_VER"    gzip
mv "libaec-$LIBAEC_VER"     szip
mv "lz4-$LZ4_VER/lib"       lz4
mv "liblzf-$LZF_VER"        lzf
mv "zstd-$ZSTD_VER/lib"     zstd
mv "blosc-$BLOSC_VER/blosc" blosc
mv "bzip2-$BZIP2_VER"       bzip2

cp -r ../src/plugins    .
cp -r ../src/utils      .
cp plugins/lz4_config.h lz4/
cp ../src/H5pubconf.h   hdf5/src/


# Copy over R's headers so we can cleanly "include" them with just `-I../R`
"$R_EXE" -s -e "invisible(file.copy(R.home('include'), '.', recursive = TRUE))"
mv include R

# Enable r_compat.h to be found from `-I../R`
cp utils/r_compat.h R/


# Construct final flags
export CC="$R_CC"
export AR="$R_AR"
export CFLAGS="$R_CFLAGS $R_CPICFLAGS -DNDEBUG -I../R $R_CPPFLAGS"

echo "  CC:     $CC"
echo "  AR:     $AR"
echo "  CFLAGS: $CFLAGS"


# Compile and run generator to detect system type sizes
# Use unquoted $CC to allow arguments like -std=gnu11
echo "  \$CC \$CFLAGS -o find_byte_widths$EXE utils/find_byte_widths.c"
$CC $CFLAGS -o find_byte_widths$EXE utils/find_byte_widths.c

echo "  ./find_byte_widths$EXE | tr -d '\r' > hdf5/src/H5_byte_widths.h"
./find_byte_widths$EXE | tr -d '\r' > hdf5/src/H5_byte_widths.h



# 5. Build BZIP2 ---------------------------------------------------------------
echo "--- [hdf5lib] Building BZIP2..."
cd bzip2

for src in *.c; do
  dest=$(basename "$src" .c).o
  echo "  \$CC \$CFLAGS -c $src -o $dest"
  $CC $CFLAGS -c $src -o $dest
done

cd ..



# 6. Build GZIP (zlib-ng) ------------------------------------------------------
echo "--- [hdf5lib] Building GZIP (zlib-ng)..."
cd gzip

chmod +x ./configure

echo "  ./configure --zlib-compat --static --without-gzfileops"
./configure --zlib-compat --static --without-gzfileops

echo "  $R_MAKE libz.a >/dev/null"
"$R_MAKE" libz.a >/dev/null

# Extract zlib-ng objects so they can be merged into libhdf5z.a later
rm -f *.o
"$R_AR" -x libz.a

cd ..


# 7. Build LZ4 -----------------------------------------------------------------
echo "--- [hdf5lib] Building LZ4..."
cd lz4

LZ4_FLAGS="-Wno-constant-logical-operand"

for src in *.c; do
  dest=$(basename "$src" .c).o
  echo "  \$CC \$CFLAGS \$LZ4_FLAGS -c $src -o $dest"
  $CC $CFLAGS $LZ4_FLAGS -c $src -o $dest
done

cd ..



# 8. Build LZF -----------------------------------------------------------------
echo "--- [hdf5lib] Building LZF..."
cd lzf

for src in *.c; do
  dest=$(basename "$src" .c).o
  echo "  \$CC \$CFLAGS -c $src -o $dest"
  $CC $CFLAGS -c $src -o $dest
done

cd ..


# 9. Build SZIP (libaec) -------------------------------------------------------

echo "--- [hdf5lib] Building SZIP (libaec)..."
cd szip

for src in src/*.c; do
  dest=$(basename "$src" .c).o
  echo "  \$CC \$CFLAGS -Iinclude -c $src -o $dest"
  $CC $CFLAGS -Iinclude -c $src -o $dest
done

cd ..


# 10. Build ZSTD (Zstandard) ----------------------------------------------------
echo "--- [hdf5lib] Building ZSTD..."
cd zstd

ZSTD_OPT="-DZSTD_LIB_MINIFY=1 -DZSTD_LIB_DICTBUILDER=0 -DZSTD_LIB_DEPRECATED=0"
ZSTD_OPT="$ZSTD_OPT -DZSTD_LEGACY_SUPPORT=0 -DZSTD_DISABLE_ASM -DZSTD_MULTITHREAD"
if [ "$WIN" -eq 0 ]; then
  ZSTD_OPT="$ZSTD_OPT -pthread"
fi

echo "  ZSTD_OPT: $ZSTD_OPT"

for src in common/*.c compress/*.c decompress/*.c; do
  dest=$(basename "$src" .c).o
  echo "  \$CC \$CFLAGS \$ZSTD_OPT -I. -Icommon -c $src -o $dest"
  $CC $CFLAGS $ZSTD_OPT -I. -Icommon -c $src -o $dest
done

cd ..


# 11. Build BLOSC ---------------------------------------------------------------
echo "--- [hdf5lib] Building BLOSC..."
cd blosc

# Fix C23 Compatibility (Remove invalid bool typedef for R >= 4.3)
perl -pi -e 's/typedef _Bool bool;//g' shuffle.c

# Bridge Blosc's MSVC thread logic to RTools' native MinGW POSIX threads
mkdir win32
echo '#include <pthread.h>' > win32/pthread.h
touch win32/pthread.c

# Tell Blosc that LZ4 and Zstd are available and where their headers are.
# Suppress benign warnings from forcing the generic fallback
BLOSC_FLAGS="-DHAVE_LZ4 -DHAVE_ZSTD -DHAVE_ZLIB -I../lz4 -I../zstd -I../gzip"
BLOSC_FLAGS="$BLOSC_FLAGS -Wno-attributes -Wno-unused-function -Wno-cpp"
BLOSC_FLAGS="$BLOSC_FLAGS -Wno-unused-variable -Wno-unused-but-set-variable"
echo "  BLOSC_FLAGS: $BLOSC_FLAGS"

for src in *.c; do
  dest=$(basename "$src" .c).o
  echo "  \$CC \$CFLAGS \$BLOSC_FLAGS -c $src -o $dest"
  $CC $CFLAGS $BLOSC_FLAGS -c $src -o $dest
done

cd ..


# 12. Build Plugins -------------------------------------------------------------
echo "--- [hdf5lib] Building Plugins..."
cd plugins

  for plugin in blosc bzip2 lz4 lzf zstd; do
    src="${plugin}_plugin.c"
    dest="${plugin}_plugin.o"
    echo "  \$CC \$CFLAGS -I../hdf5/src -I../$plugin -c $src -o $dest"
    $CC $CFLAGS -I../hdf5/src -I../$plugin -c $src -o $dest
  done

cd ..


# 13. Build HDF5 ----------------------------------------------------------------
echo "--- [hdf5lib] Building HDF5..."
cd hdf5

HDF5_FLAGS="-DH5_BUILT_AS_STATIC_LIB -DH5_DLL= -DH5HL_DLL="
HDF5_FLAGS="$HDF5_FLAGS -Isrc -Ihl/src -I../gzip -I../szip/include"
echo "  HDF5_FLAGS: $HDF5_FLAGS"

for src in src/*.c hl/src/*.c; do
  obj=$(basename "$src" .c).o
  echo "  \$CC \$CFLAGS \$HDF5_FLAGS -c $src -o $obj"
  $CC $CFLAGS $HDF5_FLAGS -c "$src" -o "$obj"
done

cd ..


# 14. Build Utilities ----------------------------------------------------------
echo "--- [hdf5lib] Building Utilities..."
cd utils

  echo "  \$CC \$CFLAGS -c r_compat.c -o r_compat.o"
  $CC $CFLAGS -c r_compat.c -o r_compat.o

  echo "  \$CC \$CFLAGS -I../hdf5/src -c register_filters.c -o register_filters.o"
  $CC $CFLAGS -I../hdf5/src -c register_filters.c -o register_filters.o

cd ..


# 15. Link and Archive ---------------------------------------------------------
echo "--- [hdf5lib] Linking static library..."

# Detect LTO and rchk/wllvm
# The MINIFY variable is a flag indicating the absence of both Link Time
# Optimization (LTO) and the wllvm compiler (used by rchk). LTO objects
# contain bytecode that standard 'strip' and 'ld -r' often corrupt, so we
# skip size-reduction steps if -flto or wllvm is detected.
MINIFY=1
case "$CFLAGS" in
  *-flto*) MINIFY=0 ;;
esac
case "$CC" in
  *wllvm*) MINIFY=0 ;;
esac

# Create the final static library
# Logic: Use partial linking (ld -r) on non-Windows systems to reduce size.
if [ "$WIN" -eq 0 ] && [ "$MINIFY" -eq 1 ] && command -v ld >/dev/null 2>&1; then
  echo "  Performing partial linking (ld -r)..."
  # Merge all .o files into one big object (deduplicates symbols/sections)
  ld -r -o libhdf5z.o hdf5/*.o blosc/*.o bzip2/*.o gzip/*.o lz4/*.o lzf/*.o szip/*.o zstd/*.o plugins/*.o utils/*.o
  "$R_AR" -crs libhdf5z.a libhdf5z.o
else
  "$R_AR" -crs libhdf5z.a hdf5/*.o blosc/*.o bzip2/*.o gzip/*.o lz4/*.o lzf/*.o szip/*.o zstd/*.o plugins/*.o utils/*.o
fi

# Strip debug symbols to reduce installed package size
if [ "$MINIFY" -eq 1 ] && command -v strip >/dev/null 2>&1; then
  echo "  Stripping debug symbols..."
  strip -S libhdf5z.a || true
fi


# 16. Installation --------------------------------------------------------------
echo "--- [hdf5lib] Installing..."
cd ..

# Install headers and library
cp build/hdf5/src/*.h            inst/include/
cp build/hdf5/hl/src/*.h         inst/include/
cp build/utils/hdf5lib_filters.h inst/include/
cp build/libhdf5z.a              inst/lib/

# Cleanup
rm -rf build

echo "  Final library size: $(du -sh inst/ | cut -f1)"
echo "--- [hdf5lib] HDF5 and Plugin Compilation Complete ---"
exit 0
