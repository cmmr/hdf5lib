#!/bin/sh
set -e

echo "--- [hdf5lib] Starting Windows/Unix configuration (STATIC) ---"

# Input directories
WD="$(pwd)"
ZLIB_SRC="$WD/src/zlib-1.3.1"
HDF5_SRC="$WD/src/hdf5-2.0.0"
HDF5_BUILD="$WD/src/hdf5_build"

# Find R
R_EXE="$R_HOME/bin$R_ARCH_BIN/R"
if ! test -f "$R_EXE"; then
  R_EXE="$R_HOME/bin/R"
  if ! test -f "$R_EXE"; then
    R_EXE=$(which R 2>/dev/null)
    if ! test -f "$R_EXE"; then
      echo "R was not found on the PATH. Please install R."
      exit 1
    fi
  fi
fi

# Find cmake
CMAKE_EXE=$(which cmake 2>/dev/null)
if ! test -f "$CMAKE_EXE"; then
  echo "CMake was not found on the PATH. Please install CMake."
  exit 1
fi

echo "  WD:        ${WD}"
echo "  R_HOME:    ${R_HOME}"
echo "  R_EXE:     ${R_EXE}"
echo "  CMAKE_EXE: ${CMAKE_EXE}"

# Detect OS
case "$(uname -s)" in
  CYGWIN*|MINGW*|MSYS*) WIN=1 ;;
  *) WIN=0 ;;
esac

# Get R's compiler/linker flags to ensure we respect the build environment
R_CC=$("$R_EXE" CMD config CC)
R_CFLAGS=$("$R_EXE" CMD config CFLAGS)
R_CPICFLAGS=$("$R_EXE" CMD config CPICFLAGS)
R_CPPFLAGS=$("$R_EXE" CMD config CPPFLAGS)
R_LDFLAGS=$("$R_EXE" CMD config LDFLAGS)
R_INCLUDE_DIR=$("$R_EXE" -s -e "cat(R.home('include'))")

# Conditionally quote R_INCLUDE_DIR if it contains whitespace.
# This prevents the path from being split into multiple arguments by the shell.
case "$R_INCLUDE_DIR" in
  *\ *)
    R_INCLUDE_DIR="\"$R_INCLUDE_DIR\""
    ;;
esac

# Combine flags and export them for downstream configure/make
# We add our own flags to the ones provided by R
export CC="${R_CC}"
export CFLAGS="${R_CFLAGS} ${R_CPICFLAGS} -O2 -g0 -w"
export CPPFLAGS="${R_CPPFLAGS} -I${R_INCLUDE_DIR} -I${ZLIB_SRC}"

echo "  CC:        ${CC}"
echo "  CFLAGS:    ${CFLAGS}"
echo "  CPPFLAGS:  ${CPPFLAGS}"

# Extract hdf5 and zlib tarballs
# Use R's internal untar for cross-platform reliability
echo "--- [hdf5lib] Decompressing HDF5 and zlib tarballs..."
cd "$WD/src"
"$R_EXE" -q -e "utils::untar('hdf5-2.0.0.tar.gz')"
"$R_EXE" -q -e "utils::untar('zlib-1.3.1.tar.gz')"


# --- 1. Build static zlib ---
echo "--- [hdf5lib] Configuring and compiling static zlib..."
cd "$ZLIB_SRC"
if [ "$WIN" -eq 1 ]; then
  echo "--- [hdf5lib] Using win32/Makefile.gcc for zlib (Windows)."
  make -f win32/Makefile.gcc libz.a
else
  echo "--- [hdf5lib] Using configure for zlib (Unix)."
  chmod +x ./configure
  ./configure --static
  make libz.a
fi


# --- 2. Build Static HDF5 2.0 with CMake ---
echo "--- [hdf5lib] Configuring HDF5 2.0..."

# Create out-of-source build directory (Required by CMake)
mkdir -p "$HDF5_BUILD"
cd "$HDF5_BUILD"

# CMake Configuration
cmake "$HDF5_SRC" \
  -DCMAKE_C_FLAGS="${CFLAGS} ${CPPFLAGS}" \
  -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_SHARED_LIBS=OFF \
  -DBUILD_TESTING=OFF \
  -DHDF5_BUILD_TOOLS=OFF \
  -DHDF5_BUILD_EXAMPLES=OFF \
  -DHDF5_ENABLE_NONSTANDARD_FEATURE_FLOAT16=OFF \
  -DHDF5_ENABLE_ZLIB_SUPPORT=ON \
  -DZLIB_USE_EXTERNAL=OFF \
  -DZLIB_LIBRARY="$ZLIB_SRC/libz.a" \
  -DZLIB_INCLUDE_DIR="$ZLIB_SRC" \
  -DCMAKE_USE_PTHREADS_INIT=ON \
  -DHDF5_ENABLE_THREADSAFE=ON \
  -DHDF5_ALLOW_UNSUPPORTED=ON \
  -Wno-dev

# Fix line endings for CRAN compliance (H5pubconf.h often has CRLF)
if [ "$WIN" -eq 1 ]; then
  echo "--- [hdf5lib] Fixing line endings in generated H5pubconf.h..."
  sed -i 's/\r$//' src/H5pubconf.h
fi

cat src/H5pubconf.h
exit 1

# Compile
echo "--- [hdf5lib] Compiling HDF5..."
cmake --build . --config Release


# --- 3. Combine, Link, and Archive ---
echo "--- [hdf5lib] Combining all object files into a single static library..."

# Extract all object files from the compiled archives
ar -x bin/libhdf5.a
ar -x bin/libhdf5_hl.a
ar -x "$ZLIB_SRC/libz.a"

# Merge all object files into a single static library
if [ "$WIN" -eq 1 ]; then
  ar -crs libhdf5z.a *.o *.obj
else
  echo "--- [hdf5lib] Linking and striping object files..."
  ld -r -o libhdf5z.o *.o
  strip -S libhdf5z.o || true
  ar -crs libhdf5z.a libhdf5z.o
fi


# --- 5. Install Libraries and Headers for R ---
echo "--- [hdf5lib] Installing to inst/..."
cd "$WD"
mkdir -p inst/lib
mkdir -p inst/include
cp "$HDF5_SRC"/src/*.h           inst/include/
cp "$HDF5_SRC"/hl/src/*.h        inst/include/
cp "$HDF5_BUILD"/src/H5pubconf.h inst/include/
cp "$HDF5_BUILD/libhdf5z.a"      inst/lib/

echo "--- [hdf5lib] Cleaning up build-time directories..."
rm -rf src

echo "--- [hdf5lib] Unix configuration complete. ---"
exit 0
